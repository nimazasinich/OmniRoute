FROM node:24-bookworm-slim

ARG OMNIROUTE_VERSION=3.8.50

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_LEGACY_PEER_DEPS=true \
    OMNIROUTE_SERVER_HOST=0.0.0.0 \
    AUTH_COOKIE_SECURE=true \
    REQUIRE_API_KEY=true \
    DATA_DIR=/tmp/omniroute \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    OMNIROUTE_MEMORY_MB=768

# Install the already-built published OmniRoute package instead of rebuilding
# the full Next.js application from source. 3.8.51 exists in the source branch
# but is not published to npm yet; 3.8.50 is the current published release.
# This path also avoids apt-get upgrade and the Debian bash update-alternatives
# warning seen in the full upstream Docker image.
RUN npm install -g --no-audit --no-fund "omniroute@${OMNIROUTE_VERSION}" \
    && test "$(omniroute --version)" = "${OMNIROUTE_VERSION}" \
    && npm cache clean --force

RUN mkdir -p /tmp/omniroute /tmp/.cache \
    && chown -R node:node /tmp/omniroute /tmp/.cache

USER node

# Fail closed on public Vercel deployments until real dashboard/API secrets exist.
# Vercel provides PORT at runtime; OmniRoute serves Dashboard and API on that
# single listener in the default single-port mode.
CMD ["sh", "-c", "if [ -z \"${JWT_SECRET:-}\" ] || [ -z \"${API_KEY_SECRET:-}\" ] || [ -z \"${INITIAL_PASSWORD:-}\" ] || [ \"${INITIAL_PASSWORD:-}\" = \"CHANGEME\" ]; then echo 'OmniRoute startup blocked: set JWT_SECRET, API_KEY_SECRET, and a non-default INITIAL_PASSWORD in Vercel.' >&2; exit 78; fi; exec omniroute serve --no-open --no-tray --no-recovery --port \"${PORT:-3000}\""]
